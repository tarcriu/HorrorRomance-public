    # game/ghostface_introduction.rpy:33
    old "Le dices que no."
    new "Dizer que não."

    # game/ghostface_introduction.rpy:42
    old "Le dices que sí."
    new "Dizer que sim."

    # game/ghostface_introduction.rpy:55
    old "Ninguna."
    new "Nenhum."

    # game/ghostface_introduction.rpy:68
    old "{size=80}Final: Adios, Sidney{/size}"
    new "{size=80}Final: Adeus, Sidney{/size}"

