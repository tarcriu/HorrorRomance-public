# TODO: Translation updated at 2025-08-05 19:34

# game/carrie_introduction.rpy:5
translate portuguese carrie_introduction_d8060c54:

    # pov "Volví a la cafetería, encontrándome con alguien en la entrada. Por su apariencia lo supe; era mi nueva mesera, [carrie]."
    pov "Chego na cafeteria e vejo alguém na entrada. Pela aparência eu a reconheci, minha nova garçonete, [carrie]."

# game/carrie_introduction.rpy:8
translate portuguese carrie_introduction_8246ae02:

    # carrie "¡Oh! Debes ser [you]. Perdona, llegue demasiado pronto ¿Vuelvo más tarde o…?"
    carrie "Ah! Você deve ser [you]. Me desculpe, cheguei muito cedo. Eu deveria voltar mais tarde ou…?"

# game/carrie_introduction.rpy:9
translate portuguese carrie_introduction_7d1152b4:

    # you "No te preocupes, más bien me caes como anillo al dedo. Debo preparar todo y limpiar me quitaba mucho tiempo ¿Puedes hacer eso?"
    you "Não se preocupe, na verdade isso é muito conveniente. Preciso organizar as coisas e limpar levaria muito tempo. Você poderia tomar conta disso?"

# game/carrie_introduction.rpy:10
translate portuguese carrie_introduction_59e40d18:

    # carrie "¡S-sí! Enseguida"
    carrie "C-Claro! Agora mesmo!"

# game/carrie_introduction.rpy:14
translate portuguese carrie_introduction_a2194697:

    # pov "[carrie] se apresuró a entrar apenas abrí la puerta. Le indiqué dónde estaban los utensilios de limpieza mientras yo fui tras la barra, acomodando las compras."
    pov "[carrie] entrou rapidamente assim que abri a porta. Eu lhe disse onde ficavam as ferramentas de limpeza enquanto fui para trás do balcão, organizando as compras."

# game/carrie_introduction.rpy:15
translate portuguese carrie_introduction_f6c8420d:

    # pov "Me encargo de triturar el café, colocar la crema en el mango y acomodar las tazas en un sitio accesible. Coloco todos los pastelillos y panes dulces en la repisa junto al mostrador."
    pov "Trituro o café, ponho o creme num recipiente e os copos num local acessível. Coloco os doces e sobremesas na prateleira ao lado do balcão."

# game/carrie_introduction.rpy:16
translate portuguese carrie_introduction_d1523a92:

    # pov "Y para cuando termino, me encontré con una cafetería impecable. [carrie] incluso había puesto los manteles en cada mesa. Extraño, ¿teníamos manteles?"
    pov "E quando termino, dou de cara com uma cafeteria impecável. Carrie até colocou toalhas em cima das mesas. Estranho, nós tínhamos alguma toalha?"

# game/carrie_introduction.rpy:17
translate portuguese carrie_introduction_d5e869f9:

    # you "¡Wow, [carrie]! Qué efectiva, gracias. Supongo que podemos abrir antes."
    you "Uau, [carrie]! Que incrível, obrigado. Acho que vamos poder abrir mais cedo."

# game/carrie_introduction.rpy:20
translate portuguese carrie_introduction_24a75076:

    # carrie "¡N-no fue nada! Soy buena limpiando. Iré a prepararme."
    carrie "¡N-não foi nada! Eu sou boa limpando. Vou me trocar."

# game/carrie_introduction.rpy:24
translate portuguese carrie_introduction_e63b820a:

    # pov "[carrie] fue tras la barra y se colocó su delantal. Mientras, aprovecho para ir a mostrar el letrero de abierto. Ya había dejado la publicidad correspondiente en el periódico, junto a un cupón, y tenía la ventaja de que el café estaba enfrente de un parque."
    pov "[carrie] vai para trás do balcão e põe seu avental. Enquanto isso, aproveito para pôr o letreiro com o sinal de ABERTO. Já havia anunciado o lugar no jornal, junto a um cupom, e tinha a vantagem da cafeteria ser bem na frente de um parque."

# game/carrie_introduction.rpy:25
translate portuguese carrie_introduction_7e7f3e84:

    # pov "Vuelvo a la barra, acercándome a [carrie]. Mientras esperaba, quería darle una pequeña charla de cómo se usaba una máquina de expresso."
    pov "Volto ao balcão, me aproximando de Carrie. Enquanto nós esperamos, queria explicar a ela como usar a máquina de espresso."

# game/carrie_introduction.rpy:26
translate portuguese carrie_introduction_9259d791:

    # you "¿Alguna vez has usado una de éstas?"
    you "Já usou uma dessas antes?"

# game/carrie_introduction.rpy:29
translate portuguese carrie_introduction_09266dac:

    # carrie "¡P-perdón! Pero no, yo jamás tuve algo así…"
    carrie "D-Desculpe, mas não, nunca tive algo assim…"

# game/carrie_introduction.rpy:30
translate portuguese carrie_introduction_1a4779e7:

    # pov "Casi salta de un infarto cuando tuvo que decir que no. Solo asentí."
    pov "Ela quase teve um infarto ao dizer que não. Eu só acenei com a cabeça."

# game/carrie_introduction.rpy:31
translate portuguese carrie_introduction_9eb72de5:

    # you "Tranquila, no debes preocuparte por no saber, es normal. No todos saben de esto. Fíjate bien."
    you "Relaxa, você não tem que se preocupar por não saber, tá tudo bem. Nem todo mundo sabe sobre isso. Me deixe explicar."

# game/carrie_introduction.rpy:32
translate portuguese carrie_introduction_82fce24b:

    # pov "Le enseñé a [carrie] lo básico; sobre el café, llenar con el agua, poner el café en el portafiltro, y le iba mostrando lo importante que es nivelar el café. Luego volví a poner el portafiltro y finalmente encendí la máquina."
    pov "Ensinei o básico a ela, como encher com água, pôr o café no porta-filtro e como nivelar o café. Então eu coloquei o porta-filtro de volta e liguei a máquina."

# game/carrie_introduction.rpy:33
translate portuguese carrie_introduction_51eeec78:

    # you "{i}¡Vualá!{/i} Así de sencillo."
    you "{i}Voilà!{/i} Desse jeitinho."

# game/carrie_introduction.rpy:36
translate portuguese carrie_introduction_0316ac55:

    # carrie "Wow, creí que era más complicado."
    carrie "Uau, eu achei que seria mais difícil."

# game/carrie_introduction.rpy:37
translate portuguese carrie_introduction_b7d3ff49:

    # you "El uso de la máquina no es problema, lo complicado está en el servicio. Servir café puede ser fácil pero tiene sus mañas, en realidad. Ahora, apréndete el menú y los ingredientes."
    you "A máquina não vai ser um problema, o trabalho que vai. Servir o café pode ser fácil, mas tem seus desafios. Agora memorize o menu e os ingredientes."

# game/carrie_introduction.rpy:41
translate portuguese carrie_introduction_2a2e2902:

    # pov "Ha llegado un cliente, así que indico a [carrie] que se encargue de llevarle el café una vez lo tenga."
    pov "Um cliente chegou, então eu peço para Carrie levar o café quando ele estiver pronto."

# game/carrie_introduction.rpy:42
translate portuguese carrie_introduction_5bdc0131:

    # pov "Me acerco a la barra, notando a un señor alto de cabello negro. Lo más destacable de él es que tiene una mano de metal."
    pov "Me aproximo do balcão, vendo um homem alto de cabelo escuro. Sua característica mais perceptível era uma mão de metal."

# game/carrie_introduction.rpy:43
translate portuguese carrie_introduction_d96e506e:

    # you "Bienvenido al café [coffee_shop] ¿Qué puedo servirle?"
    you "Bem-vindo à cafeteria [coffee_shop] como posso lhe servir?"

# game/carrie_introduction.rpy:46
translate portuguese carrie_introduction_d77b6df1:

    # ash "Vaya, así que esta pocilga ha reabierto, y con una monada sirviendo. Me gusta, el antiguo dueño parecía tener un palo en el culo."
    ash "Olha só, reabriram essa pocilga. E com uma gatinha servindo. O último dono parecia que tinha uma vassoura enfiada no cu."

# game/carrie_introduction.rpy:47
translate portuguese carrie_introduction_92ef9bf6:

    # pov "El tipo soltó una risa. No sé si reír o levantar una ceja."
    pov "O homem ri, não sei se eu deveria rir com ele ou levantar uma sobrancelha."

# game/carrie_introduction.rpy:48
translate portuguese carrie_introduction_d92d3ca1:

    # you "No llegué a conocerlo mucho. Me limito a hacer café."
    you "Não o conheci muito bem. Me limito a fazer café."

# game/carrie_introduction.rpy:49
translate portuguese carrie_introduction_87fc9c9b:

    # ash "Es todo lo que espero. Bien, será un americano, con whiskey."
    ash "Isso é tudo o que espero. Bem, me vê um americano, com whisky."

# game/carrie_introduction.rpy:50
translate portuguese carrie_introduction_15160ae6:

    # you "… No tenemos eso en el menú"
    you "… Não temos isso no menu"

# game/carrie_introduction.rpy:54
translate portuguese carrie_introduction_8db53a6a:

    # ash "Vamos, un buen café ¿sin whiskey? No soy marica ¿no tienes alguna botella por ahí?" nointeract
    ash "Qual é, não dá pra se ter um bom café sem whisky. Eu não sou um maricas, não tem nenhuma garrafa aqui?" nointeract

# game/carrie_introduction.rpy:56
translate portuguese carrie_introduction_36735a42:

    # you "Nope, no tengo permiso de servir alcohol, podrá ponérselo usted."
    you "Não, eu não tenho permissão pra servir álcool. Você pode adicionar você mesmo."

# game/carrie_introduction.rpy:59
translate portuguese carrie_introduction_e6d493fa:

    # ash "Puta madre."
    ash "Que merda."

# game/carrie_introduction.rpy:60
translate portuguese carrie_introduction_6a7d68dd:

    # you "Puede sentarse si quiere, ya va a salir su café."
    you "Pode se sentar se quiser, seu café já está saindo."

# game/carrie_introduction.rpy:61
translate portuguese carrie_introduction_5ee55ce7:

    # ash "Está bien, esperaré aquí. Tengo algo de prisa."
    ash "Tudo bem, vou esperar aqui mesmo. Estou com pressa."

# game/carrie_introduction.rpy:62
translate portuguese carrie_introduction_6d6067a9:

    # pov "Preparo su café, lo sirvo en una taza y se lo entrego."
    pov "Preparo seu café, ponho em um copo e entrego a ele."

# game/carrie_introduction.rpy:63
translate portuguese carrie_introduction_937eca61:

    # pov "El tipo, aún con una cara de amarga decepción, toma su taza y bebe de ella. Su mirada cambia a una más relajada una vez prueba el café."
    pov "Ele pega o copo, ainda com uma expressão amarga, e toma um gole. Seu rosto fica relaxado logo depois."

# game/carrie_introduction.rpy:66
translate portuguese carrie_introduction_373a6fbe:

    # ash "Vaya, y aún así sabe bastante bien. Vale, supongo que seguiré viniendo aquí. Traeré mi whiskey a la próxima."
    ash "Nossa, o gosto é ótimo. Vou passar aqui mais vezes. Com meu whisky, claro."

# game/carrie_introduction.rpy:68
translate portuguese carrie_introduction_236ea7f4:

    # pov "Lo miro unos segundos y suspiro. Luego miro a los lados y le hago un gesto para que se espere."
    pov "Eu o encaro por alguns segundos e suspiro. Olhando para ambos os lados antes de gesticular para que ele espere."

# game/carrie_introduction.rpy:71
translate portuguese carrie_introduction_7b81bf15:

    # pov "Me mira curioso mientras me encargo de preparar su americano. Al terminar, sostengo la taza y voy a la parte del almacén. Allí abro una caja con mis cosas."
    pov "Ele olha curioso enquanto eu preparo o americano. Ao terminar, pego o copo e vou até a sala nos fundos. Lá eu abro uma caixa com algumas das minhas coisas."

# game/carrie_introduction.rpy:72
translate portuguese carrie_introduction_db6256c0:

    # pov "Uno de mis favoritos, Jack Daniels. A veces, en los días difíciles, me tomaba media botella y me ahogaba en mis lágrimas hasta perder el conocimiento. Ahora solo lo sirvo en la taza de café, procurando que sea la medida apropiada para añadirle algo de sabor sin pasarme."
    pov "Um dos meus favoritos, Jack Daniels. Às vezes, nos dias difíceis, bebo metade da garrafa e afogo as mágoas até desmaiar. Agora, estou colocando no café, medindo a quantidade para adicionar sabor sem exagerar."

# game/carrie_introduction.rpy:73
translate portuguese carrie_introduction_82a97896:

    # pov "Volví a la barra y le serví el café al sujeto."
    pov "Voltei ao balcão e entreguei o café ao sujeito."

# game/carrie_introduction.rpy:74
translate portuguese carrie_introduction_101e13fa:

    # you "Aquí tiene. Una taza de café americano sin nada extra, porque no tenemos permiso para servir alcohol."
    you "Aqui está. Um americano sem uma gota de álcool, já que não temos permissão para servir isso."

# game/carrie_introduction.rpy:75
translate portuguese carrie_introduction_742849f0:

    # pov "El tipo me miró ligeramente titubeante y luego bajó la mirada a la taza. Finalmente la toma y bebe, sonriendo lleno de satisfacción."
    pov "Ele olha para mim curioso, antes de olhar para o copo. Finalmente ele o pega e bebe, sorrindo de satisfação."

# game/carrie_introduction.rpy:78
translate portuguese carrie_introduction_ce5bb00a:

    # ash "¡Perfecto! Ahora sé a dónde venir por mi americano “sin nada extra”, ¡jaja!"
    ash "Perfeito! Agora eu sei onde vir quando quiser um americano “sem uma gota de álcool”, hahaha!"

# game/carrie_introduction.rpy:79
translate portuguese carrie_introduction_6184a60e:

    # pov "Se rió bastante alegre, supongo que aún soy un poco débil para cumplir algunos caprichos. O el tipo se parecía a un tío que solo quería tomar un pequeño trago, sin más."
    pov "Ele riu, bastante satisfeito. Acho que ainda não resisto aos meus desejos. Ou isso, ou O cara só parecia um tiozão que realmente precisava de um drink."

# game/carrie_introduction.rpy:80
translate portuguese carrie_introduction_6499c47e:

    # ash "Ten, monada, tu paga y una propina."
    ash "Aqui, doçura, seu pagamento e sua gorjeta."

# game/carrie_introduction.rpy:81
translate portuguese carrie_introduction_4c0bcdcb:

    # pov "Toma mi mano y pone algo en ella además de la paga, cerrándola."
    pov "Ele pega minha mão e coloca algo estranho nela, além do pagamento, a fechando."

# game/carrie_introduction.rpy:82
translate portuguese carrie_introduction_16c7b3d5:

    # ash "Es para la buena suerte. Créeme, no me gustaría que le pasase algo a mi nueva cafetería favorita."
    ash "É pra dar sorte. Vai por mim, eu não gostaria que nada acontecesse com meu novo barista favorito."

# game/carrie_introduction.rpy:83
translate portuguese carrie_introduction_da165971:

    # ash "Éste pueblo es raro y muy peligroso, así que cuida tu espalda."
    ash "Essa cidade é esquisita e perigosa, toma cuidado por aí."

# game/carrie_introduction.rpy:84
translate portuguese carrie_introduction_616be279:

    # pov "Da una palmadita a mi mano y se va con su vaso de café tarareando alguna tonada."
    pov "Ele dá um tapinha na minha mão e sai segurando seu copo de café, cantarolando uma musiquinha."

# game/carrie_introduction.rpy:88
translate portuguese carrie_introduction_cd720398:

    # pov "Observo al extraño tipo irse. Miro mi mano aún cerrada, haciendo una mueca, y al abrirla me encuentro con la mierda más rara que he visto en años."
    pov "Olho o esquisito indo embora e meus olhos imediatamente se redirecionam para minha mão ainda fechada. Curioso, ao abrir vejo a merda mais bizarra que vi nos últimos anos."

# game/carrie_introduction.rpy:90
translate portuguese carrie_introduction_dc16a232:

    # pov "Era un jodido dedo cercenado y seco. Era incapaz de saber si era real o no."
    pov "Era a porra de um dedo arrancado e seco. Eu não sabia dizer se era real ou falso."

# game/carrie_introduction.rpy:92
translate portuguese carrie_introduction_bd23e672:

    # pov "Miro hacia la puerta, sin saber qué demonios era todo eso. Escucho a [carrie] acercarse y me apresuro a guardar el dedo y a poner el dinero en la caja."
    pov "Olho para a porta, sem saber o que foi aquilo. Escuto [carrie]  se aproximando e rapidamente ponho o dedo no bolso e o dinheiro no caixa."

# game/carrie_introduction.rpy:95
translate portuguese carrie_introduction_83725d18:

    # carrie "¡Nuestro primer cliente! ¿Cuánto fue?"
    carrie "Nosso primeiro cliente! Quanto ganhamos?"

# game/carrie_introduction.rpy:96
translate portuguese carrie_introduction_5b056ab7:

    # pov "Noté cierta emoción infantil en ella y no pude evitar sonreír."
    pov "Notei uma alegria infantil vindo dela e não pude reagir se não sorrindo."

# game/carrie_introduction.rpy:97
translate portuguese carrie_introduction_72673013:

    # you "Un increíble dólar con 25 centavos."
    you "Um incrível dólar com 25 centavos."

# game/carrie_introduction.rpy:98
translate portuguese carrie_introduction_1588bc1d:

    # pov "Ella nota que estaba bromeando y empezó a reír tímidamente."
    pov "Ela percebe a brincadeira e ri timidamente."

# game/carrie_introduction.rpy:101
translate portuguese carrie_introduction_bd9945e8:

    # carrie "Como para retirarse, ¿no?"
    carrie "Já podemos nos aposentar, não é?"

# game/carrie_introduction.rpy:103
translate portuguese carrie_introduction_0bcbb3a6:

    # pov "Suelto una carcajada al ver que seguía el chiste, pero en seguida siento un abrupto cambio en [carrie] cuando la campanilla de los clientes suena de nuevo."
    pov "Solto uma risada, percebendo que a piada ainda continuava. Naquele mesmo momento, percebo uma mudança abrupta na atitude de Carrie, no instante em que o sino da porta toca de novo."

# game/carrie_introduction.rpy:105
translate portuguese carrie_introduction_ab0b09df:

    # pov "Antes de mirar hacia la entrada, miro el rostro de [carrie]. Primero parece sorprendida de ver a quién sea que haya llegado. Luego su expresión cambia a una de incomodidad."
    pov "Antes de olhar para a porta, vejo o rosto de Carrie. Primeiro ela pareceu surpresa vendo quem entrou e então, sua expressão mudou para uma de desconforto."

# game/carrie_introduction.rpy:108
translate portuguese carrie_introduction_45351d35:

    # carrie "Oh no, es ella…"
    carrie "Ah não, é ela…"

# game/carrie_introduction.rpy:109
translate portuguese carrie_introduction_42936e6e:

    # you "¿Quién?"
    you "Quem?"

# game/carrie_introduction.rpy:114
translate portuguese carrie_introduction_8b4701e3:

    # pov "Me vuelvo hacia la puerta para ver de quién se trataba, mientras escucho a [carrie] huir hacia el almacén. Sólo vi a una joven rubia vestida de forma bastante costosa y de marca. Tenía cara de pocos amigos y la nariz arrugada, como si el café oliera mal."
    pov "Me viro e olho para a cliente que acaba de entrar, enquanto escuto Carrie correndo para se esconder no estoque. Tudo o que vejo é uma garota loira, vestida em roupas de marca. Com uma face nem um pouco amigável, seu nariz estava enrugado como se ela cheirasse algo horrível."

# game/carrie_introduction.rpy:118
translate portuguese carrie_introduction_0eed69c6:

    # chanel "Urgh, otra estúpida cafetería de pueblo."
    chanel "Urgh, outra cafeteria de pobre."

# game/carrie_introduction.rpy:119
translate portuguese carrie_introduction_5bf73011:

    # you "¿Disculpa…?"
    you "Perdão…?"

# game/carrie_introduction.rpy:121
translate portuguese carrie_introduction_65113dea:

    # chanel "Quiero un trenta latte sin espuma, cinco shots de descafeinado, esencia de calabaza y sin espuma, 98 °C."
    chanel "Quero um trenta latte sem espuma, cinco shots de descafeinado, essência de abóbora e sem espuma, 98 °C."

# game/carrie_introduction.rpy:122
translate portuguese carrie_introduction_36040832:

    # pov "Parpadeo sin comprender del todo la actitud de ésta niña. Inmediatamente me percato de que es ésas chicas ricas mimadas. Genial, mi tipo de persona favorita con la que toparme."
    pov "Eu pisco, não entendendo a atitude dessa garota. Imediatamente percebo que é uma daquelas riquinhas mimadas. Ótimo, meu tipo favorito de cliente."

# game/carrie_introduction.rpy:123
translate portuguese carrie_introduction_5ea6f434:

    # you "Es peligroso servir café a esa temperatura, puede quemarse."
    you "É perigoso servir café quente assim, você pode se queimar."

# game/carrie_introduction.rpy:125
translate portuguese carrie_introduction_6a8e6aea:

    # chanel "¿Perdón? ¿No escuchas? No te pedí consejo, te pedí café. No me cuestiones y haz tu estúpido trabajo."
    chanel "OI? Você tá com cera no ouvido? Eu não pedi a sua opinião, eu pedi um café. Menos perguntas e mais trabalho!"

# game/carrie_introduction.rpy:127
translate portuguese carrie_introduction_acdedc01:

    # pov "Respiro hondo y aprieto los dientes." nointeract
    pov "Respiro fundo e cerro os dentes." nointeract

# game/carrie_introduction.rpy:130
translate portuguese carrie_introduction_f2a0c037:

    # pov "Tragándome el coraje que tengo ahora mismo, decido hacer lo más sensato para el negocio; hacerle su trenta latte. Mientras lo hago, fantaseo con tirárselo por encima y arruinarle el maquillaje... O, con un poco de suerte, provocarle quemaduras de primer grado, que es lo que pasaría con un café a esa temperatura. Finalmente hago el pedido exacto."
    pov "Engulo a raiva e faço a coisa mais razoável para os negócios, a porcaria do trenta latte. Enquanto fantasiava sobre jogá-lo na cara dela, estragando a maquiagem, ou com um pouco de sorte, fazendo o rosto dela derreter. É o que acontece com um café nessa temperatura. Finalmente o pedido está pronto."

# game/carrie_introduction.rpy:131
translate portuguese carrie_introduction_687deb68:

    # you "Aquí tienes."
    you "Aqui está."

# game/carrie_introduction.rpy:132
translate portuguese carrie_introduction_50478dc8:

    # pov "En vez de tomar la maldita taza, la rubia se dedica a observarla encima del mostrador."
    pov "En vez de pegar a maldita xícara, o projeto de Regina George apenas encara."

# game/carrie_introduction.rpy:134
translate portuguese carrie_introduction_a70a6bb3:

    # chanel "Para llevar."
    chanel "Pra viagem."

# game/carrie_introduction.rpy:135
translate portuguese carrie_introduction_698f441c:

    # pov "Me sonríe con la misma malicia que una niña caprichosa. Me está poniendo a prueba, lo sé. Pero no caigo en la trampa. Agarro la taza y con cuidado vierto el contenido en uno de nuestros vasos de cartón. Me quemo ligeramente los dedos, pero no permito que mi cara lo demuestre."
    pov "Ela sorri com a mesma malícia de uma pirralha arrogante. Ela está me testando, eu sei. Mas não vou cair nessa. Pego a xícara e cuidadosamente passo seu café para um de nossos copos de papel. Queimo levemente meus dedos, mas não demonstro."

# game/carrie_introduction.rpy:136
translate portuguese carrie_introduction_5b187c31:

    # you "Listo. ¿Algo más?"
    you "Pronto, algo mais?"

# game/carrie_introduction.rpy:137
translate portuguese carrie_introduction_012efcb3:

    # pov "Al menos ahora sé que no se va a quedar mucho tiempo por aquí. Ni siquiera la conozco y ya quiero que desaparezca."
    pov "Pelo menos agora sei que ela não vai ficar por aqui. Mal a conheço e já quero ela longe de mim."

# game/carrie_introduction.rpy:139
translate portuguese carrie_introduction_7f04149d:

    # pov "Prueba el café en pequeños sorbos. Frunce los labios, como si estuviera disgustada por no encontrar nada de lo que quejarse."
    pov "Ela bebe em goles minúsculos. Franzindo os lábios como se estivesse enojada por não achar algo para reclamar."

# game/carrie_introduction.rpy:141
translate portuguese carrie_introduction_4bfe8197:

    # chanel "Mmmm… Pasable. Me sorprende que esté casi perfecto."
    chanel "Hmmm… Decente. Me surpreende que esteja quase perfeito."

# game/carrie_introduction.rpy:142
translate portuguese carrie_introduction_ceab783a:

    # pov "Creo que eso es lo más cercano a un halago que ha dicho nunca."
    pov "Deve ser o mais próximo de um elogio que já saiu da boca dela."

# game/carrie_introduction.rpy:143
translate portuguese carrie_introduction_f3311e4c:

    # pov "Extiende una mano con la manicura perfecta y tira un billete de 20$ en el mostrador. Se va hacia la puerta sin esperar el cambio y sin despedirse."
    pov "Ela estende sua mão e joga 20$ no balcão, saindo pela porta sem se despedir ou esperar o troco."

# game/carrie_introduction.rpy:149
translate portuguese carrie_introduction_d29f620d:

    # you "¡Gracias! ¡Vuelva pronto!"
    you "Obrigado, volte sempre!"

# game/carrie_introduction.rpy:150
translate portuguese carrie_introduction_6a68b384:

    # inner "{i}Dios mío, ojalá te atropellen.{/i}"
    inner "{i}Já vai tarde, espero que te atropelem.{/i}"

# game/carrie_introduction.rpy:152
translate portuguese carrie_introduction_ceb51e8c:

    # you "No tenemos eso en el menú, lo siento. Y es una irresponsabilidad hacer café a esa temperatura."
    you "Desculpe, não temos isso no menu. E é irresponsável fazer café nessa temperatura."

# game/carrie_introduction.rpy:154
translate portuguese carrie_introduction_a02c87bf:

    # chanel "¿Qué? ¿Cómo no vas a tener un trenta latte? ¿Qué clase de café de cuarta es ésta?"
    chanel "O QUÊ? Como é possível que vocês não tenham um trenta latte? Que tipo de cafeteria de última categoria é essa?"

# game/carrie_introduction.rpy:155
translate portuguese carrie_introduction_ec66d20a:

    # you "Acabamos de abrir y aún no tenemos esencia de calabaza. No sé cuándo podrán traerlas. Qué tragedia."
    you "Acabamos de abrir e ainda não temos essência de abóbora, não sei quando iremos ter. Uma lástima."

# game/carrie_introduction.rpy:156
translate portuguese carrie_introduction_69753fce:

    # pov "En realidad, la esencia de calabaza está debajo del mostrador, sin abrir. Me niego a hacerle el café. La vida me ha demostrado que las cosas se piden con respeto y educación, y ésta ricachona no tiene ninguna de las dos cosas."
    pov "Na verdade a essência está logo abaixo do balcão, lacrada. Mas eu me recuso a fazer esse café. A vida me mostrou que pedidos são feitos com respeito e educação e essa patricinha não tem nenhum dos dois."

# game/carrie_introduction.rpy:158
translate portuguese carrie_introduction_cc06f5e2:

    # chanel "¡Lo estás haciendo a propósito! ¿Sabes quién soy? ¡Soy [chanel] Oberlin! ¡Mi padre es el alcalde! ¡Voy a hacer que cierren tu puta cafetería! ¡Acabarás en la calle!"
    chanel "Você está fazendo isso de propósito! Sabe quem eu sou? Eu sou [chanel] Oberlin! Meu pai é o prefeito! Eu vou fazer esse projetinho de café fechar! Você vai morar embaixo de uma ponte!"

# game/carrie_introduction.rpy:159
translate portuguese carrie_introduction_468edb8e:

    # you "Me pueden cerrar el café… ¿Por no tener esencia de calabaza?"
    you "Podem fechar a cafeteria por… Não ter essência de abóbora?"

# game/carrie_introduction.rpy:160
translate portuguese carrie_introduction_b27d5fbc:

    # pov "Me fulmina con la mirada. Mi tono condescendiente no le ha gustado en absoluto, pero le sonrío encantadoramente."
    pov "Seus olhos penetram minha alma, posso ver que ela está furiosa, mas eu apenas sorrio."

# game/carrie_introduction.rpy:162
translate portuguese carrie_introduction_2dbc2c80:

    # chanel "¿Te crees muy inteligente, verdad? Haré que te arrepientas de esto."
    chanel "Você se acha inteligente, né? Vou fazer você se arrepender."

# game/carrie_introduction.rpy:168
translate portuguese carrie_introduction_b6fc1dae:

    # pov "Se da la vuelta, casi golpeándome con su melena rubia, y se marcha por la puerta. Sus tacones enfurecidos golpean el piso, haciéndose notar, hasta alejarse."
    pov "Ela dá a volta, quase me chicoteando com aquela juba loira. Seu salto batuca no chão a cada passo, como se ela marcasse território."

# game/carrie_introduction.rpy:169
translate portuguese carrie_introduction_0238cff4:

    # you "¡Gracias por su visita! ¡Vuelva pronto!"
    you "Obrigado pela visita! Volte sempre!"

# game/carrie_introduction.rpy:173
translate portuguese carrie_introduction_160c7a04:

    # carrie "L-Lo siento mucho. [chanel] me aterra… He ido a esconderme al almacén."
    carrie "M-Me desculpe, a [chanel] me assusta demais. Eu me escondi no estoque."

# game/carrie_introduction.rpy:174
translate portuguese carrie_introduction_93b11276:

    # you "No te preocupes. Puedo ver por qué."
    you "Não se preocupe, eu posso ver o porquê."

# game/carrie_introduction.rpy:177
translate portuguese carrie_introduction_74e993da:

    # carrie "Lo he visto todo, o casi todo. Eres muy valiente…"
    carrie "Eu vi tudo. Bem, quase tudo. Você tem tanta coragem…"

# game/carrie_introduction.rpy:178
translate portuguese carrie_introduction_4ddd717c:

    # pov "Lo dice con admiración en la voz. Yo me encojo de hombros, sin darle más importancia. Cuando has estado en prisión y vivido lo que he vivido yo, se necesita más que una rubia caprichosa y mimada para asustarte."
    pov "Ela fala com admiração. Eu dou de ombros, não me importando muito. Quando se é preso e se passa pelo que eu passei, leva mais que uma loirinha mimada pra te assustar."

# game/carrie_introduction.rpy:179
translate portuguese carrie_introduction_581f6d00:

    # you "La gente no te intimida si tú no se lo permites, [carrie]. Ven, tenemos que organizar algunas cosas ahí atrás."
    you "Pessoas só podem te intimidar se você deixar, [carrie]. Vamos, precisamos organizar algumas coisas lá atrás."

translate portuguese strings:

    # game/carrie_introduction.rpy:55
    old "Servirle el americano sin alcohol"
    new "Servir um americano sem álcool"

    # game/carrie_introduction.rpy:67
    old "Servirle el americano con alcohol"
    new "Servir um americano com álcool"

    # game/carrie_introduction.rpy:128
    old "Hacerle caso y darle lo que pide."
    new "O cliente sempre tem razão."

    # game/carrie_introduction.rpy:151
    old "Negarse e invitarla a irse."
    new "Você está convidada a se retirar."
