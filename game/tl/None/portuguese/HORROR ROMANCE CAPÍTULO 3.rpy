# game/HORROR ROMANCE CAPÍTULO 3.rpy:1280
translate portuguese rutas_646cb85b:

    # j "Ella jamás haría algo para lastimarme, me ama"
    j "Ela me ama, não faria nada pra me machucar"

# game/HORROR ROMANCE CAPÍTULO 3.rpy:1282
