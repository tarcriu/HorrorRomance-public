# game/HORROR ROMANCE CAPÍTULO 3.rpy:3493
translate portuguese rutas_64819c9c:

    # chanel "Obvio, medio millón no los tiene cualquier perdedor. ¿Tú qué quieres?, ¿un autógrafo?"
    chanel "Claro que sim, não é qualquer um que consegue chegar em meio milhão. Você quer um autógrafo ou coisa do tipo?"

# game/HORROR ROMANCE CAPÍTULO 3.rpy:3495
