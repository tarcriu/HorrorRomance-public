    you "Tudo bem, grandão, não precisamos falar disso se você não quiser"

# game/HORROR ROMANCE CAPÍTULO 3.rpy:1313
translate portuguese rutas_129cb4d3:

    # pov "Noto cómo sus hombros se relajan y deja escapar aire. Voltea a verme y asiente"
    pov "Seus ombros relaxam e ele suspira aliviado, olhando pra mim e acenando"

# game/HORROR ROMANCE CAPÍTULO 3.rpy:1319
