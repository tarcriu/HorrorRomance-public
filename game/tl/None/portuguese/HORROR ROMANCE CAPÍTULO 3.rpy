    pov "Me aproximo de uma prateleira na saída e suspiro, abrindo o meu picolé"

# game/HORROR ROMANCE CAPÍTULO 3.rpy:1401
translate portuguese rutas_2409e496:

    # you "Comamos aquí, afuera hay mucho sol, los helados se derretirán en un chasquido"
    you "Vamos comer aqui, o sol está muito forte hoje, os sorvetes iriam evaporar lá fora"

# game/HORROR ROMANCE CAPÍTULO 3.rpy:1403
