# game/HORROR ROMANCE CAPÍTULO 3.rpy:1249
translate portuguese rutas_82542106:

    # pov "Puedo ver la alegría al notar sus hombros alzarse ligeramente, ponemos la máscara entre las demás cosas en lo que continuamos la tarea"
    pov "Ele levanta seus ombros, emanando alegria, colocamos a máscara no carrinho e continuamos nossas compras"

# game/HORROR ROMANCE CAPÍTULO 3.rpy:1250
