    pov "Jason olha pra mim mais uma vez antes de começar a mover as mãos"

# game/HORROR ROMANCE CAPÍTULO 3.rpy:1560
translate portuguese rutas_698a898c:

    # j "Gracias por eso"
    j "Obrigado por isso"

# game/HORROR ROMANCE CAPÍTULO 3.rpy:1562
