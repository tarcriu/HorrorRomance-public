    you "I'm serious, Freddy. Get me out of here."

# game/HORROR ROMANCE CAPÍTULO 3.rpy:2271
translate english rutas_84554919:

    # pov "Sólo escucho su risa mientras empiezo a caminar"
    pov "The only response I get is his laughter as I begin to walk."

# game/HORROR ROMANCE CAPÍTULO 3.rpy:2275
