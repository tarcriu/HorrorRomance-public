# game/HORROR ROMANCE CAPÍTULO 3.rpy:3576
translate english continuacion_5776b154:

    # pov "Cuando termino de hacer los cálculos de gastos en la decoración, nuevos ingredientes, nueva marca y todo lo demás, suelto un largo suspiro"
    pov "After I'm done with the expenses for decoration, ingredients, branding and everything else, I let out a long sigh"

# game/HORROR ROMANCE CAPÍTULO 3.rpy:3577
translate english continuacion_1703574d:

