# game/HORROR ROMANCE CAPÍTULO 3.rpy:2287
translate english rutas_6ca816ea:

    # pov "No quiero creer que en serio me jugaba esta broma, así que abro la puerta rápidamente"
    pov "I don't want to believe he'd actually pull this stunt. I wrench the door open."

# game/HORROR ROMANCE CAPÍTULO 3.rpy:2296
translate english rutas_570ece5e:

    # pov "Es mi casa de la infancia"
    pov "It's my childhood home."

# game/HORROR ROMANCE CAPÍTULO 3.rpy:2300
translate english rutas_3b521502:

    # pov "Siento mi respiración entrecortada, como si un nudo se hiciera en mi pecho"
    pov "I can feel my breathing falter, as if a knot was forming in my chest."

# game/HORROR ROMANCE CAPÍTULO 3.rpy:2301
translate english rutas_9aeec347:

