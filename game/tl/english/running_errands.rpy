    # pov "Camino por la ciudad yendo al súper antes de ir al café por suministros de último minuto."
    pov "I walk around the city going to the supermarket before going to the cafe for last minute supplies."

# game/running_errands.rpy:5
translate english running_errands_0f6fd5b1:

    # pov "No me toma mucho tiempo así que me dirijo al café que para mi suerte está cerca del súper."
    pov "It doesn’t take me long, so I head to the cafe, which luckily for me is near the supermarket."

# game/running_errands.rpy:6
translate english running_errands_a9ee573c:

    # pov "Al llegar, [carrie] está en la puerta de servicio esperando."
    pov "When I arrive, [carrie] is at the door, waiting."

# game/running_errands.rpy:9
translate english running_errands_29bc6dba:

    # you "Recuérdame darte un bono de puntualidad."
    you "Remind me to give you a punctuality bonus."

# game/running_errands.rpy:10
translate english running_errands_1bbee147:

    # carrie "No tienes que preocuparte por eso, me basta con la paga."
    carrie "You don't have to worry about that, the pay is enough for me."

# game/running_errands.rpy:11
translate english running_errands_79c357e8:

    # pov "Suelto una risa mientras me dirijo a abrir la puerta y entrar al café para finalmente empezar el turno de hoy."
    pov "I chuckle as I head to open the door and enter the cafe to finally start today’s shift."

# game/running_errands.rpy:19
translate english running_errands_1fd157a7:

    # pov "Me encamino al almacén para preparar todo."
    pov "I’m heading to the warehouse to get everything ready."

# game/running_errands.rpy:22
translate english running_errands_c9a233b9:

    # you "Ordena las mesas mientras me encargo del café."
    you "Clear the tables while I take care of the coffee."

# game/running_errands.rpy:25
translate english running_errands_0b02bae3:

    # carrie "En seguida."
    carrie "Right away!"

# game/running_errands.rpy:29
translate english running_errands_d5abd629:

    # pov "Saco algunas bolsas de café y las coloco en una cesta, junto con especias y leche."
    pov "I take out some bags of coffee and put them in a basket, along with spices and milk."

# game/running_errands.rpy:30
translate english running_errands_56122b58:

    # pov "Voy a la barra para encender las cafeteras y la licuadora, me fijo que está todo listo y para cuando me doy cuenta [carrie] ya había terminado con las mesas."
    pov "I go to the counter to turn on the coffee makers and the blender, I notice that everything is ready and before I know it, [carrie] has already finished with the tables."

# game/running_errands.rpy:31
translate english running_errands_04f97a7f:

    # you "¿Ya? Mierda, eres más ágil y rápida de lo que parece."
    you "Already? Shit, you’re more agile and faster than you look."

# game/running_errands.rpy:34
translate english running_errands_3cbfa813:

    # carrie "Es algo que se me da bien."
    carrie "It’s one thing I’m good at."

# game/running_errands.rpy:37
translate english running_errands_1122ea48:

    # carrie "Por cierto, tienes más ojeras bajo los ojos. ¿Has dormido bien?"
    carrie "By the way, you’ve got more dark circles under your eyes. Did you sleep well?"

# game/running_errands.rpy:38
translate english running_errands_2d5ce99e:

    # you "A decir verdad, no he dormido bien desde hace años, pero me mantengo funcional. Es lo que importa."
    you "To be honest, I haven’t slept well for years, but I’m still functional. That’s what matters."

# game/running_errands.rpy:41
translate english running_errands_26e1c570:

    # carrie "Sé lo que es eso…"
    carrie "I know what that’s like…"

# game/running_errands.rpy:44
translate english running_errands_5a69ad6f:

    # carrie "Pero aprendí formas de dormir bien, pese a todo. Cuando quieras, te las digo."
    carrie "But I’ve learned ways to sleep well, despite everything. I'll tell you whenever you want."

# game/running_errands.rpy:45
translate english running_errands_f88f67d2:

    # pov "Le sonrío por su buena voluntad. Carrie se siente como una brisa de aire fresco en mi vida, tan dulce y genuina."
    pov "I answer her good will with a smile. [carrie] feels like a breath of fresh air in my life, so sweet and genuine."

# game/running_errands.rpy:46
translate english running_errands_5ed43f15:

    # you "De acuerdo, me las puedes decir cuando estemos cerrando, por ahora ya estamos listos. Pon el cartel, para que ya entren clientes."
    you "Okay, you can tell me when we're closing, we're all set up for now. Put up the sign so customers can come in."

# game/running_errands.rpy:49
translate english running_errands_f8adde1e:

    # pov "Carrie se va a abrir el café y encargarse de cualquier cosa tras la barra."
    pov "[carrie] is going to open the cafe and take care of everything behind the counter."

# game/running_errands.rpy:50
translate english running_errands_c5100f5b:

    # pov "Pronto algunos clientes vienen por su café. Empiezo a enfocarme en la sencilla tarea."
    pov "Soon some customers come for their coffee. I start to focus on the simple tasks."

# game/running_errands.rpy:51
translate english running_errands_549b6b91:

    # inner "Preparar, montar, calentar, servir."
    inner "Prepare, mix, heat, serve."

# game/running_errands.rpy:52
translate english running_errands_0359ca85:

    # pov "Se repite en mi cabeza como mantra y eso me relaja por un rato, hasta que una pequeña figura me sorprende."
    pov "It repeats in my head like a mantra and that relaxes me for a while, until a small figure surprises me."

# game/running_errands.rpy:55
translate english running_errands_08439f78:

    # c "Esta vez sí vine a tiempo."
    c "Today I came right on time."

# game/running_errands.rpy:56
translate english running_errands_b7c52dbf:

    # inner "Ahg, esto de nuevo."
    inner "Ahg, this again."

# game/running_errands.rpy:57
translate english running_errands_eff6be69:

    # you "Ya es algo, supongo. Bienvenido, ¿qué vas a querer?"
    you "That's something, I guess. Welcome, what would you like?"

# game/running_errands.rpy:58
translate english running_errands_16ed92a7:

    # c "Lo mismo de ayer, y rápido, encanto."
    c "Same as yesterday, and quick, darling."

# game/running_errands.rpy:61
translate english running_errands_e991e492:

    # pov "Suelto un suspiro y me encargo de hacer el café como lo pidió ayer; un caramel macchiato. Hice una mueca al ver la cantidad de azúcar que tenía y solo decidí entregarle su bebida sin decirle nada más."
    pov "I let out a sigh and went to make the coffee like he asked for yesterday; a caramel macchiato. I grimaced at the amount of sugar in it and just decided to hand him his drink without saying anything else."

# game/running_errands.rpy:62
translate english running_errands_2680c6ba:

    # you "Bebida para… ¿Charlie?"
    you "Drink for… Charlie?"

# game/running_errands.rpy:65
translate english running_errands_472b75e8:

    # c "¡Es [c]!"
    c "It’s [c]!"

# game/running_errands.rpy:66
translate english running_errands_ee491d23:

    # you "¿Quién carajos se llama [c]?"
    you "Who the fuck’s called {i}[c]{/i}?"

# game/running_errands.rpy:69
translate english running_errands_d72c0b43:

    # c "¿Quién carajos se llama [you]?"
    c "Who the fuck’s called [you]?"

# game/running_errands.rpy:70
translate english running_errands_7ede5933:

    # pov "Casi me arranca el vaso de la mano, pero no lo alcanzó. Me controlo para no reírme y le tendí el vaso. Sólo lo tomó, irritado."
    pov "He almost snatched the glass from my hand, but he didn’t reach it. I controlled myself from laughing and handed him the glass. He just took it, irritated."

# game/running_errands.rpy:71
translate english running_errands_5b35478c:

    # pov "Sin embargo, cuando le dió un sorbo pareció que toda su molestia se fue de su rostro."
    pov "However, when he took a sip, all the annoyance seemed to leave his face."

# game/running_errands.rpy:74
translate english running_errands_954e8bde:

    # c "Mi favorito, lo preparas muy bien. Me harás venir aquí más seguido."
    c "My favorite, you prepare it very well. You will make me come here more often."

# game/running_errands.rpy:75
translate english running_errands_3afadb97:

    # you "La propina es en efectivo, no en intentos de coqueteo."
    you "Tipping is handed in cash, not in flirtatious attempts."

# game/running_errands.rpy:78
translate english running_errands_ef158e85:

    # c "Tú te lo pierdes."
    c "Your loss."

# game/running_errands.rpy:81
translate english running_errands_cfc37b56:

    # pov "Veo al más bajo tomar su café y sentarse en los sillones del fondo. Suspiro y veo a [carrie] pasar junto a él, confundida."
    pov "I watch the shortstack drink his coffee and sit down in the armchairs at the back. I sigh and watch [carrie] walk past him, confused."

# game/running_errands.rpy:82
translate english running_errands_944c512d:

    # pov "Se queda tan desconcertada que termina por acercarse de nuevo hacia donde estoy yo."
    pov "She is so baffled that she ends up approaching me again."

# game/running_errands.rpy:85
translate english running_errands_a9419749:

    # carrie "¿Por qué hay un muñeco Good Guy tomando un café?"
    carrie "Why is there a Good Guy doll drinking coffee?"

# game/running_errands.rpy:86
translate english running_errands_f048d8dc:

    # you "¿Un… Qué cosa?"
    you "A… what, now?"

# game/running_errands.rpy:89
translate english running_errands_31a686dd:

    # carrie "Good Guy, fueron muy populares en los 90, sacaron una línea nueva hace poco, más tecnológicos y grandes. Ya sabes, más modernos."
    carrie "Good Guy, very popular in the 90’s, they recently released a new line, more technological and bigger. You know, modernized?"

# game/running_errands.rpy:90
translate english running_errands_7e273d55:

    # inner "No lo había notado hasta que Carrie lo mencionó. Era un jodido muñeco, ciertamente. Me fijé en sus manos, pasa muy desapercibido de lo bien hecho que está pero tiene proporciones pequeñas, juveniles. Ya me extrañaba que agarrase la taza con ambas manos."
    inner "I hadn’t noticed until Carrie mentioned it. He was a fucking doll, indeed. I noticed his hands, he’s so inconspicuous because he’s so well made, but he has small, youthful proportions. I was already wondering how he was holding the cup with both hands."

# game/running_errands.rpy:91
translate english running_errands_dbcdf133:

    # you "¿Sabes que? A este punto no quiero saber nada, simplemente ignóralo."
    you "You know what? At this point I don’t want to know anything, just ignore it."

# game/running_errands.rpy:94
translate english running_errands_558d3378:

    # carrie "¿Ok… Okay?"
    carrie "O… kay?"

# game/running_errands.rpy:97
translate english running_errands_521bd8da:

    # pov "Decido ignorar al muñeco. Quizás solo es alguien jugando a manejarlo o es un disfraz muy bien hecho, alguna tontería así. No necesito enfocarme en eso ahora."
    pov "I choose to ignore the doll. Maybe it’s just someone playing with it, or it’s a really well made costume, something silly like that. I don’t need to focus on that right now."

# game/running_errands.rpy:98
translate english running_errands_a4b959ca:

    # pov "Me concentro en el trabajo. Recibo un pedido con leche de almendra, pero rápidamente noto que ya se acabó. Necesito buscar más en el almacén."
    pov "I focus on work. I get an order for almond milk, but I quickly notice that it’s already gone. I need to go find more in the warehouse."

# game/running_errands.rpy:99
translate english running_errands_3241be2d:

    # pov "No lo pienso mucho y después de asegurarme de que [carrie] está atendiendo bien al resto de clientes, me dirijo hacia la parte de atrás."
    pov "I don’t think about it much and after making sure [carrie] is taking care of the rest of the customers, I head to the back."

# game/running_errands.rpy:102
translate english running_errands_21d4b964:

    # pov "Me acerco a la repisa a buscar la leche entre los productos. Intento estirarme para alcanzar hasta arriba, pero… ¿Alguien lo agarra?"
    pov "I go to the shelf to get the milk among the products. I try to stretch to reach up, but… someone grabs it…?"

# game/running_errands.rpy:103
translate english running_errands_fe7932f2:

    # pov "Me espanto terriblemente al ver una mano con garras filosas sostener la leche y ofrecerla."
    pov "I’m scared to death when I see a hand with sharp claws holding milk and offering it."

# game/running_errands.rpy:104
translate english running_errands_b8ca1a6f:

    # pov "Al bajar la mirada veo un rostro horriblemente quemado, pero con rasgos muy llamativos."
    pov "Looking down, I see a horribly burned face, but with very striking features."

# game/running_errands.rpy:107
translate english running_errands_df14b10c:

    # you "¡AH!"
    you "AH!"

# game/running_errands.rpy:108
translate english running_errands_6b45f4a1:

    # pov "Doy un salto hacia atrás del susto, notando a la figura frente a mí."
    pov "I jump back in fright, noticing the figure in front of me."

# game/running_errands.rpy:109
translate english running_errands_0afad37e:

    # you "¿Quién eres? ¡Éste sitio es para empleados!"
    you "Who are you?! This place is for employees only!"

# game/running_errands.rpy:112
translate english running_errands_a475fda4:

    # f "Ah, ahora si te asusté."
    f "Oh, so now you’re scared."

# game/running_errands.rpy:113
translate english running_errands_5568d9cb:

    # you "Oiga, ¿me escuchó, señor? Retírese o llamo a la policía."
    you "Hey, did you hear me, sir?! Back off or I’ll call the police."

# game/running_errands.rpy:116
translate english running_errands_f49cf2ef:

    # f "Amaría verte intentarlo."
    f "I’d love to see you try that."

# game/running_errands.rpy:117
translate english running_errands_24a4a52e:

    # pov "Veo que examina la leche."
    pov "I see him examining the milk."

# game/running_errands.rpy:118
translate english running_errands_3a2d82c4:

    # f "[you] ¿verdad? No pareces nada especial. Entonces, ¿por qué no pude matarte?"
    f "[you] right? You don’t seem like anything special. So… why couldn’t I kill you?"

# game/running_errands.rpy:119
translate english running_errands_b3ae8fbd:

    # you "¿Qué…?"
    you "What…?"

# game/running_errands.rpy:120
translate english running_errands_1f19b021:

    # f "Sí, anoche en el jodido sueño. No tenías nada de miedo, incluso me sacaste de tu pesadilla de una patada."
    f "Yeah, last night in the fucking dream. You weren’t scared at all, you even {i}kicked{/i} me out of your nightmare."

# game/running_errands.rpy:121
translate english running_errands_ede7b505:

    # pov "Proceso todo lo que me dice, pero me resulta imposible. ¿Mi sueño? ¿Éste tipo era el del sueño? Bueno, tiene una silueta similar… Sin embargo, no tenía sentido."
    pov "I process everything he tells me, but it just seems impossible. My dream? Was this guy from the dream? Well, he has a similar silhouette… However, it didn’t make sense."

# game/running_errands.rpy:122
translate english running_errands_2a1fc28b:

    # you "…Sí, definitivamente enloquecí."
    you "…Yup, definitely went nuts now."

# game/running_errands.rpy:123
translate english running_errands_2183d794:

    # pov "Termino agarrando el cartón de leche de su mano y camino de nuevo a la puerta."
    pov "I end up grabbing the carton of milk from his hand and walking back to the door."

# game/running_errands.rpy:126
translate english running_errands_55677343:

    # inner "Si lo ignoro, se irá. Es una ilusión. Otra vez estoy alucinando, es simplemente eso."
    inner "If I ignore him, he’ll go away. It’s just an illusion. I’m hallucinating again, that’s all it is."

# game/running_errands.rpy:129
translate english running_errands_a223eccb:

    # pov "Salgo a la barra y me enfoco en preparar el café. No dejo de repetirme lo mismo una y otra vez; es una alucinación. Primero el muñeco y ahora él, es un día extraño y no es ni mediodía."
    pov "I go out to the bar and focus on making coffee. I keep repeating the same thing to myself over and over again; it’s a hallucination. First the doll and now him, it’s a strange day and it’s not even noon."

# game/running_errands.rpy:132
translate english running_errands_4da753e9:

    # f "Qué modales, ¿no te enseñaron a no dejar a otros hablando solos?"
    f "Some manners you have, weren’t you taught not to leave others talking to themselves?"

# game/running_errands.rpy:133
translate english running_errands_5c811083:

    # you "¡Ah! Jo… Der."
    you "Oh sh-- it!"

# game/running_errands.rpy:134
translate english running_errands_6c77888a:

    # pov "Doy un brinco del susto y casi derramo el café, pero lo salvo. Termino de prepararlo, controlando el temblar de mis manos por el pequeño ataque de ansiedad que atenaza mi respiración."
    pov "I jump in fright and almost spill the coffee, but I save it. I finish preparing it, controlling the shaking of my hands due to the small anxiety attack that grips my breathing."

# game/running_errands.rpy:135
translate english running_errands_c5994b69:

    # you "Pedido listo."
    you "Order ready."

# game/running_errands.rpy:136
translate english running_errands_4215e34f:

    # f "No puedes ignorarme por siempre, ¿lo sabes? Puedo literalmente atormentar tus sueños."
    f "You can’t ignore me forever, you know that, right? I can {i}literally{/i} haunt your dreams."

# game/running_errands.rpy:137
translate english running_errands_8beb2bf5:

    # you "No serías el primero, te lo aseguro."
    you "Wouldn’t be the first one, I assure you."

# game/running_errands.rpy:138
translate english running_errands_e06f7f52:

    # pov "No parece tomarlo mejor. Abre la boca para contestarme pero el cliente que viene por su bebida es el que le dirige la palabra… ¿También puede verlo?"
    pov "He doesn’t seem to be taking it any better. He opens his mouth to answer me but the customer who comes for his drink is the one who speaks to him… Can they see him too?"

# game/running_errands.rpy:139
translate english running_errands_914c167b:

    # mclient1 "¡Wow! Tu maquillaje es genial, luce tan realista. Es un {i}cosplay{/i} genial."
    mclient1 "Wow! Your makeup is great, it looks so realistic. It’s a {i}great{/i} cosplay."

# game/running_errands.rpy:142
translate english running_errands_79e8b16f:

    # f "Sí, sí, lo que sea. Piérdete, imbécil."
    f "Yeah, yeah, whatever. Get lost, moron."

# game/running_errands.rpy:143
translate english running_errands_6323f82b:

    # mclient2 "Parece el de esa leyenda… La del tipo de los sueños."
    mclient2 "He looks like the one from that legend… The one about the dream guy."

# game/running_errands.rpy:144
translate english running_errands_e87306cc:

    # pov "Los clientes se van, conversando intrigados por hombre el frente a mí."
    pov "Customers leave, chatting intrigued by the man in front of me."

# game/running_errands.rpy:145
translate english running_errands_cdd4859c:

    # inner "Si pueden verlo es porque no es un producto de mi imaginación… ¿Es real, entonces? Debería dejar de ignorarlo."
    inner "If they can see him, he’s not a figment of my imagination… Is he real, then? I should stop ignoring him."

# game/running_errands.rpy:146
translate english running_errands_90de7459:

    # you "… ¿Quién eres?"
    you "… Who are you?"

# game/running_errands.rpy:149
translate english running_errands_77c39fb0:

    # f "[f] Krueger, era conocido por las pesadillas, pero… Digamos que no ha salido demasiado bien."
    f "[f] Krueger, known for the nightmares, but… Let’s just say it didn’t turn out too well."

# game/running_errands.rpy:150
translate english running_errands_c8b42825:

    # you "¿Entonces eres como… Un ente onírico? ¿Un demonio de la parálisis del sueño?"
    you "So you’re like a… dream entity? A sleep paralysis demon?"

# game/running_errands.rpy:153
translate english running_errands_0579b140:

    # f "Algo así. Lo he explicado demasiadas veces ya, y me resulta tedioso. Quédate con ésa explicación."
    f "Something like that. I’ve explained it too many times already and it’s annoying. Stick with that explanation."

# game/running_errands.rpy:154
translate english running_errands_88cb1575:

    # you "Mierda, ésta ciudad no puede ser más rara… ¿Y si quieres matarme, por qué no lo haces ahora?"
    you "Shit, this city can’t be any weirder… And if you wanna kill me, why don’t you do it now?"

# game/running_errands.rpy:157
translate english running_errands_d58fda34:

    # f "Primero, no es solo así. Esto es un arte, basurita, {i}MI{/i} arte. Segundo, no tengo tanta fuerza y libertad en el mundo terrenal, así que no puedo."
    f "First off: it’s not just like that. This is art, you little shit, {i}MY{/i} art. Second, I don’t have that much strength and freedom in the earthly world, so I can’t."

# game/running_errands.rpy:158
translate english running_errands_af951046:

    # f "Pero es allí donde vuelve el problema, tú eras mi víctima ayer, y no pude matarte… ¿Por qué?"
    f "But that's where the issue comes in: you were my victim last night and I couldn't kill you… {i}Why{/i}?"

# game/running_errands.rpy:159
translate english running_errands_091d5b86:

    # you "Qué sé yo. A mí qué me cuentas."
    you "What do I know? You’re the expert."

# game/running_errands.rpy:162
translate english running_errands_5e746f6d:

    # pov "Me quejé volviendo al trabajo mientras servía otro pedido, vi a unas chicas admirando el “maquillaje” de Freddy."
    pov "I complained as I was returning to work while serving another order, I saw some girls admiring [f]’s “makeup”."

# game/running_errands.rpy:163
translate english running_errands_59c44687:

    # fclient1 "Wow, tu apariencia es brutal."
    fclient1 "Wow, your appearance is brutal."

# game/running_errands.rpy:164
translate english running_errands_1f7e6473:

    # fclient2 "No sabía que este café era con temática de horror."
    fclient2 "I didn’t know this cafe was horror themed."

# game/running_errands.rpy:165
translate english running_errands_0489f68d:

    # pov "Las escucho parlotear y ruedo los ojos, en éstos días los jóvenes pueden follarse cualquier cosa."
    pov "I listen to them chatter and roll my eyes, these days young people wanna fuck everything."

# game/running_errands.rpy:166
translate english running_errands_0e86a49c:

    # pov "Sigo ignorando a [f] y me enfoco en servir, pero noto que más pedidos empiezan a llegar."
    pov "I continue to ignore [f] and focus on serving the meals, but I notice more orders starting to come in."

# game/running_errands.rpy:167
translate english running_errands_afce2950:

    # pov "Más y más, todos comentan y hablan con [f], éste empezó a seguir con la mentira del “disfraz” explicando como lo hizo. Menudo showman está hecho."
    pov "More and more, everyone talks to and about [f], he started to continue with the lie of the “costume” explaining how he did it. What a showman he is."

# game/running_errands.rpy:168
translate english running_errands_893ee948:

    # pov "Noto que más gente se une a escucharlo, pero también un grupo se sienta con [c]. Al parecer éste solo bromea con insultos y la gente se ríe, entretenida."
    pov "I notice more people joining in to listen to him, but a group also sits down with [c]. Apparently he only jokes with insults and people laugh, amused."

# game/running_errands.rpy:169
