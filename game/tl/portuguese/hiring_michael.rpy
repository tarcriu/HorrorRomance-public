# game/hiring_michael.rpy:5
translate portuguese hiring_michael_ed3523a4:

    # pov "Aún hay luz del día así que debería apurarme, mi experiencia en el pueblo me ha demostrado que no es seguro quedarse al anochecer."
    pov "Ainda tem uma migalha de sol, eu deveria me apressar, meu último dia na cidade me mostrou que não é seguro ficar aqui depois de anoitecer."

# game/hiring_michael.rpy:6
translate portuguese hiring_michael_ff4dd8e7:

    # pov "Por el camino me pongo a pensar en la gente que he conocido en ésta extraña ciudad. [f] y [c] harán un buen trabajo, pero no pueden hacerlo solos."
    pov "No caminho pra casa, penso nas pessoas que conheci nessa cidade estranha. O [f] e o [c] vão fazer um bom trabalho, com certeza, mas não sozinhos."

# game/hiring_michael.rpy:7
translate portuguese hiring_michael_822a97e9:

    # inner "Tengo vecinos muy curiosos, la verdad, alguno debe servir… [m] se ve aterrador. Quizá es buena idea hablar con él para lo del café. No se me ocurre a nadie mejor."
    inner "Eu tenho uns vizinhos curiosos, pensando bem, alguns deles poderiam ser úteis… O [m] parece assustador o bastante, talvez seja uma boa ideia falar com ele sobre a cafeteria."

# game/hiring_michael.rpy:8
translate portuguese hiring_michael_63936575:

    # inner "Sin embargo, [jack], mi casero, me inquieta más. Por alguna razón que no comprendo… Aún."
    inner "Mas o meu senhorio, [jack], ele sim me dá calafrios. Por algum motivo que eu não entendo… Ainda."

# game/hiring_michael.rpy:9
translate portuguese hiring_michael_b227568e:

    # inner "Tendré que evitar hablar con él a menos que sea estrictamente necesario."
    inner "Vou evitar falar com ele além do necessário."

# game/hiring_michael.rpy:13
translate portuguese hiring_michael_a33987b8:

    # inner "Mal para mí, la noche cayó rápidamente. Entro al edificio y busco el departamento de [m], recuerdo que su hermana [laurie] me dijo dónde buscarla."
    inner "Infelizmente a noite caiu. Entro no prédio buscando o apartamento do [m], lembro que a sua irmã [laurie] me disse onde procurar por ela."

# game/hiring_michael.rpy:14
translate portuguese hiring_michael_7eef4427:

    # pov "Carraspeo buscando darme valor y toco la puerta con mis nudillos. Espero a que alguien venga, y escucho unos pasos pesados de unas botas y la puerta se abre."
    pov "Engulo em seco, buscando coragem e bato na porta. Logo escuto passos pesados e a porta se abre."

# game/hiring_michael.rpy:17
translate portuguese hiring_michael_5ddd4d7a:

    # pov "La figura enorme de [m] está enfrente mía, con su pose intimidante y cruzando los brazos. Parece esperar a que diga algo."
    pov "A figura enorme de [m] aparece na minha frente, na sua pose intimidadora de sempre. Ele parece esperar que eu fale algo."

# game/hiring_michael.rpy:18
translate portuguese hiring_michael_950cd7a7:

    # you "Ah… ¡Hola vecino!"
    you "Opa… Boa noite vizinho!"

# game/hiring_michael.rpy:19
translate portuguese hiring_michael_9480eadc:

    # pov "Me cuesta hablar por un momento. Su mirada se clava en mí como cuchillas. Qué presencia tan intimidante."
    pov "Quase engasgo com as palavras, a encarada dele me perfura como uma faca."

# game/hiring_michael.rpy:20
translate portuguese hiring_michael_3c112c07:

    # you "Llamaba a tu puerta porque… Bueno, estoy buscando gente para mi café con un perfil especial."
    you "Eu vim aqui porquê… Bem, eu estou procurando pessoas com um perfil específico pra a minha cafeteria."

# game/hiring_michael.rpy:21
translate portuguese hiring_michael_01b9a376:

    # you "Un perfil… Llamativo."
    you "Um perfil… Chamativo."

# game/hiring_michael.rpy:22
translate portuguese hiring_michael_1422b626:

    # pov "Mierda, no sé ni que estoy diciendo. No se mueve ni un milímetro."
    pov "Porra, eu nem sei o que eu tô dizendo, ele não se move nem pra respirar."

# game/hiring_michael.rpy:23
translate portuguese hiring_michael_ee499c20:

    # inner "¿Éste hombre siquiera respira?"
    inner "Por acaso esse cara respira?"

# game/hiring_michael.rpy:24
translate portuguese hiring_michael_bd898186:

    # you "Bueno, sólo si te interesa, me hace falta personal…"
    you "Bem, se você se interessar, precisamos de funcionários…"

# game/hiring_michael.rpy:29
translate portuguese hiring_michael_b99a79f6:

    # laurie "¿Trabajo? ¿Le ofreces trabajo a mi hermano?"
    laurie "Funcionários? Você tá oferecendo um trabalho pra ele?"

# game/hiring_michael.rpy:30
translate portuguese hiring_michael_5ff3d435:

    # pov "Empiezo a arrepentirme. Creo que los estoy molestando, su hermana tiene una presencia similar a la de él. Menudo par más intimidante."
    pov "Começo a me arrepender de ter vindo pra cá, talvez eu esteja incomodando eles. A irmã passa uma sensação parecida, que dupla assustadora."

# game/hiring_michael.rpy:31
translate portuguese hiring_michael_f06d5c54:

    # you "Sólo es una idea, no quiero imponerme."
    you "É só uma ideia, não quero ser {0}invasivo{/0}{1}invasiva{/1}{2}invasive{/2}"

# game/hiring_michael.rpy:34
translate portuguese hiring_michael_f4886995:

    # laurie "¿Bromeas? ¡Es una excelente noticia! ¿Sabes lo mucho que le cuesta conseguir trabajo?"
    laurie "Tá brincando? É uma notícia ótima! Tem ideia do quão difícil é pra ele conseguir um emprego?"

# game/hiring_michael.rpy:37
translate portuguese hiring_michael_ee406452:

    # laurie "[m] es estupendo como mano de obra, te ayudará con lo que necesites."
    laurie "[m] é um faz-tudo incrível, vai te ajudar com o que você precisar."

# game/hiring_michael.rpy:38
translate portuguese hiring_michael_0a1bdb4a:

    # m "Aún no he dicho que sí."
    m "Eu ainda não concordei."

# game/hiring_michael.rpy:39
translate portuguese hiring_michael_cec2938b:

    # inner "Me sorprendo cuando le escucho hablar. Lo hace tan poco que se me olvida que puede hacerlo."
    inner "Me surpreendi ouvindo ele falar. Por um momento achei que ele fazia parte da decoração."

# game/hiring_michael.rpy:42
translate portuguese hiring_michael_80d27149:

    # laurie "¿Lo dices en serio? No sigas haciendo trabajos para el señor Torrance."
    laurie "Tá falando sério? Você precisa parar de trabalhar pra o Sr. Torrance."

# game/hiring_michael.rpy:45
translate portuguese hiring_michael_dd5a1a13:

    # laurie "¿De cuánto es la paga?"
    laurie "Qual o salário?"

# game/hiring_michael.rpy:46
translate portuguese hiring_michael_94fac8ec:

    # pov "Le cuento los detalles de horario, paga y deberes. [m] parece más interesado ahora que está informado."
    pov "Repasso os detalhes da agenda, pagamento e deveres. Ele parece mais interessado depois de se informar."

# game/hiring_michael.rpy:49
translate portuguese hiring_michael_d1008eec:

    # laurie "Parece buena oferta. Vamos [m], ¡te pagará más que el señor Torrance en dos semanas!"
    laurie "Parece bom. Vamos, [m], você vai receber bem mais que agora."

# game/hiring_michael.rpy:50
translate portuguese hiring_michael_1a45d1e7:

    # m "… De acuerdo."
    m "… Ok."

# game/hiring_michael.rpy:51
translate portuguese hiring_michael_4437a8eb:

    # laurie "¡Genial! Oh, es tu primer trabajo serio, increíble. Muchas gracias, [you]."
    laurie "Ótimo! Ah, o seu primeiro trabalho de verdade, isso é incrível, muito obrigada, [you]."

# game/hiring_michael.rpy:52
translate portuguese hiring_michael_4821e496:

    # you "Gracias a ustedes. Mañana ven a ésta dirección."
    you "Eu que agradeço. Aqui está o endereço."

# game/hiring_michael.rpy:53
translate portuguese hiring_michael_6d32832c:

    # pov "Le doy la información a los dos y me despido. [m] fue el primero en entrar de vuelta a su casa, espero que no esté de mal humor en el trabajo por presión de su hermana…"
    pov "Lhes dou as informações e me despeço. [m] foi o primeiro a voltar pra casa, espero que ele não trabalhe de mal humor por causa da pressão…"

# game/hiring_michael.rpy:54
translate portuguese hiring_michael_ea96345d:

    # inner "Como sea. No puedo perder más tiempo."
    inner "Que seja. Eu não tenho mais tempo a perder."

# game/hiring_michael.rpy:55
translate portuguese hiring_michael_69507b40:

    # pov "Decido enfocarme en el siguiente. Espero encontrarlo allí así que camino a la ciudad."
    pov "Foco na próxima contratação. Espero encontrar ele pela cidade."
